// Fleur A/B testing — split-test assignment, funnel capture and results.
//
// Deliberately separate from fleur-financials: the ingest endpoint is publicly
// writable (shoppers' browsers call it), and that does not belong in the app
// holding the Shopify/Meta/Amazon keys and the financial data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A running or finished experiment. Kept as a row rather than a constant so
/// the ingest endpoint can reject events for unknown or already-stopped tests,
/// and so the stopping rule is recorded *before* any data arrives — deciding it
/// afterwards is how peeking creeps in.
model AbTest {
  key           String    @id /// e.g. "pdp_redesign_2607" — matches the theme cookie
  name          String
  hypothesis    String?
  primaryMetric String    @default("add_to_cart") /// the metric the run length was powered for
  plannedDays   Int       @default(21)
  startedAt     DateTime?
  endsAt        DateTime?
  stoppedAt     DateTime?
  createdAt     DateTime  @default(now())

  events AbEvent[]
  orders AbOrder[]
}

/// One row per funnel event beaconed from the storefront. Purchases are NOT
/// here — they arrive via the order sync, which reads the bucket back off the
/// order's cart attribute.
///
/// `visitorId` is an anonymous random id set alongside the bucket cookie. Rates
/// are computed per visitor, not per row: without it a shopper who views the
/// PDP five times would count five times in the denominator.
model AbEvent {
  id        String   @id @default(cuid())
  test      String
  bucket    String /// "a" | "b"
  visitorId String
  event     String /// "exposure" | "add_to_cart" | "initiate_checkout"
  path      String?
  template  String?
  createdAt DateTime @default(now())

  abTest AbTest @relation(fields: [test], references: [key], onDelete: Cascade)

  /// One row per visitor per event type — a repeat add-to-cart from the same
  /// shopper must not inflate the numerator.
  @@unique([test, visitorId, event])
  @@index([test, event, bucket])
  @@index([createdAt])
}

/// Orders attributed to an arm via the bucket stamped into the cart attribute.
/// Sourced from Shopify rather than the browser — this is the only
/// revenue-grade number in the test.
model AbOrder {
  id         String   @id /// Shopify order id
  test       String
  bucket     String
  orderName  String
  visitorId  String?
  totalPrice Decimal  @db.Decimal(12, 2)
  currency   String   @default("USD")
  placedAt   DateTime
  syncedAt   DateTime @default(now())

  abTest AbTest @relation(fields: [test], references: [key], onDelete: Cascade)

  @@index([test, bucket, placedAt])
}

/// A completed discount quiz, recorded server-side.
///
/// The PDP asks this before it shows or charges a discounted price. The cookie
/// the quiz drops is a hint for fast rendering, not the authority: it is
/// settable from the console in seconds, and once the unlock decides which
/// selling plan the form submits, a cookie alone would be the only thing
/// between a shopper and $108 off a 6-month plan.
///
/// Keyed on the anonymous visitor id already used for the funnel, so this adds
/// no new identifier and stays consistent with how rates are counted. Cross
/// device is a known gap — a shopper who takes the quiz on a phone and buys on
/// a laptop is a new visitor id and has to retake it.
model QuizUnlock {
  visitorId String   @id
  /// The ladder earned: 17, 24 or 31. Stored so the PDP grants exactly what
  /// was won rather than assuming the ceiling.
  target    Int
  /// The SMS bonus, if the number was given. Separate because it is a one-time
  /// code on the first order, not part of the recurring selling plan.
  bonus     Int      @default(0)
  email     String?
  createdAt DateTime @default(now())
  /// Matches the cookie's life. An unlock that never expires is a permanent
  /// price change for that visitor.
  expiresAt DateTime

  @@index([expiresAt])
}

/// One row per completed quiz, kept for analysis rather than for the storefront.
///
/// The answers already reach Klaviyo as profile properties, which is what makes
/// them usable for segments and audience exports. What that cannot do is
/// aggregate: Klaviyo holds the latest state of a person, overwritten on every
/// retake, and has no way to ask "what share of takers report shedding" or
/// "which answers precede a purchase". This is a row per completion, in the
/// same database as the funnel events and the orders, so those questions are a
/// join rather than an export.
///
/// Keyed on the anonymous visitor id the funnel already uses, so a completion
/// can be lined up with that visitor's exposures and their order without
/// introducing another identifier.
///
/// Note what this is: hair-loss, postpartum and menopause answers next to an
/// email address. It is the same data Klaviyo already holds, but it is worth
/// being deliberate that it now sits here too.
model QuizResponse {
  id        String   @id @default(cuid())
  visitorId String
  email     String?
  /// The ladder they entered on: 17, 24 or 31.
  target    Int
  bonus     Int      @default(0)
  /// The derived segment the quiz itself computed, stored beside the raw
  /// answers so a change to the scoring rules does not rewrite history.
  persona   String?
  /// The full answer set, as the quiz recorded it.
  answers   Json
  createdAt DateTime @default(now())

  @@index([visitorId])
  @@index([createdAt])
  @@index([persona])
}

/// Where people leave the quiz.
///
/// QuizResponse is a row per *completion*, so every question the data can
/// answer is conditioned on survival. If one group abandons more than another,
/// its share of completions is understated and its conversion rate is measured
/// on whichever subset tolerated the questionnaire — and nothing in the schema
/// could tell you that was happening. Persona shares were being read as
/// audience composition when they were composition-after-attrition.
///
/// One row per attempt, updated in place as the shopper advances, so an
/// abandoned run leaves the step they stopped on and the answers they had given
/// by then. That second part is what makes it useful rather than merely a
/// funnel count: `lifestage` is the fourth question, so anyone who gets past it
/// has already declared menopause, postpartum or stress before they quit.
///
/// Deliberately separate from QuizResponse rather than a nullable completion on
/// one table: a completion is a fact about a shopper and is kept, while these
/// are observations about a session and can be pruned without losing anything.
model QuizProgress {
  id String @id @default(cuid())
  /// The same anonymous id the funnel and the unlock use, so drop-off joins to
  /// exposures and orders without a new identifier.
  visitorId String
  /// One run of the quiz. A retake is a second funnel, not an overwrite of the
  /// first — otherwise abandoning and then succeeding would erase the abandon.
  attempt String
  /// The step id they are on now, e.g. 'concern', 'email', 'results'.
  step String
  /// Position of that step, and the furthest they ever reached. The two differ
  /// when someone goes back, and only the second describes how far they got.
  stepIndex Int @default(0)
  furthest  Int @default(0)
  /// Answers as they stood at the last beacon. The point of the table.
  answers   Json?
  completed Boolean @default(false)
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([visitorId, attempt])
  @@index([startedAt])
  @@index([step])
  @@index([completed])
}
